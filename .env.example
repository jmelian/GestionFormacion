# .env.example - Plantilla para Sistema de Gestión de Formación v1.0
# Copia este archivo como .env y configura los valores apropiados
# IMPORTANTE: No uses comillas alrededor de los valores

# === CONFIGURACIÓN BÁSICA DE DJANGO ===
# Genera una nueva SECRET_KEY para producción
SECRET_KEY=tu_clave_secreta_muy_larga_y_aleatoria_aqui
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# === CONFIGURACIÓN DE BASE DE DATOS ===
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=formacion_db
POSTGRES_USER=formacion_user
POSTGRES_PASSWORD=tu_password_seguro_aqui
DB_HOST_LOCAL=localhost
DB_HOST_DOCKER=db
DB_PORT=5432

# === CONFIGURACIÓN DE ZONA HORARIA ===
TIME_ZONE=Atlantic/Canary

# === CONFIGURACIÓN DE EMAIL ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_o_password_normal
DEFAULT_FROM_EMAIL=tu_email@gmail.com

# === CONFIGURACIÓN DE PRODUCCIÓN (descomentar para prod) ===
# DEBUG=False
# SECRET_KEY=clave_muy_larga_para_produccion
# ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True