# .env.example - Plantilla para Sistema de Gestión de Formación v1.4
# Copia este archivo como .env y configura los valores apropiados
# IMPORTANTE: No uses comillas alrededor de los valores

# === CONFIGURACIÓN BÁSICA DE DJANGO ===
# Genera una nueva SECRET_KEY para producción
SECRET_KEY='tu_clave_secreta_muy_larga_y_aleatoria_aqui'
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# === CONFIGURACIÓN DE BASE DE DATOS ===
DB_ENGINE='django.db.backends.postgresql'
POSTGRES_DB='formacion_db'
POSTGRES_USER='formacion_user'
POSTGRES_PASSWORD='tu_password_seguro_aqui'
DB_HOST_LOCAL='localhost'
DB_HOST_DOCKER='db'
DB_PORT=5432

# === CONFIGURACIÓN DE ZONA HORARIA ===
TIME_ZONE='Atlantic/Canary'

# === CONFIGURACIÓN DE EMAIL ===
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST='smtp.servidor.es'
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER='xxxx@servidor.es'
EMAIL_HOST_PASSWORD='password'
DEFAULT_FROM_EMAIL='notificacion@gestionFormacion'
EMAIL_SUBJECT_PREFIX='[GesForm]'

# === CONFIGURACIÓN DE URL BASE ===
# URL base para enlaces absolutos en emails
BASE_URL='http://localhost:8082'

# === CONFIGURACIÓN LDAP (Opcional) ===
# Para habilitar autenticación LDAP, establece LDAP=True
LDAP=False
AUTH_LDAP_SERVER_URI='ldap://tu-servidor-ldap.com:389'
LDAP_BIND_DN='uid={0},ou=users,dc=empresa,dc=com'
LDAP_BIND_PASSWORD='tu_password_ldap_aqui'

# === CONFIGURACIÓN DE MONITORIZACIÓN ===
# Umbrales para alertas y health checks (valores por defecto incluidos)
MONITORING_CPU_CRITICAL=95
MONITORING_CPU_HIGH=85
MONITORING_CPU_MEDIUM=70
MONITORING_MEMORY_CRITICAL=95
MONITORING_MEMORY_HIGH=85
MONITORING_MEMORY_MEDIUM=70
MONITORING_DISK_CRITICAL=95
MONITORING_DISK_HIGH=90
MONITORING_DISK_MEDIUM=80
MONITORING_RESPONSE_TIME_CRITICAL=10.0
MONITORING_RESPONSE_TIME_HIGH=5.0
MONITORING_RESPONSE_TIME_MEDIUM=2.0
MONITORING_ERROR_RATE_CRITICAL=5.0
MONITORING_ERROR_RATE_HIGH=1.0
MONITORING_ERROR_RATE_MEDIUM=0.5
MONITORING_AVAILABILITY_TARGET=99.9

# === CONFIGURACIÓN DE PRODUCCIÓN (descomentar para prod) ===
# DEBUG=False
# SECRET_KEY=clave_muy_larga_para_produccion
# ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True